rules_version = '2';

// TripTogether security rules.
//
// Core idea: everything about a trip lives under trips/{tripId}, so almost every
// rule reduces to "is the caller in this trip's memberIds array". The one thing
// outsiders may read is a single inviteCodes doc (by exact code) — never a list.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isMember(tripId) {
      return signedIn() && uid() in tripData(tripId).memberIds;
    }

    // Post-batch view: needed when the trip doc and its subdocs (member, days)
    // are created in ONE batched write — get() would still see "no trip" and
    // deny everything. getAfter() equals get() outside a batch, so this is safe.
    function isMemberAfter(tripId) {
      return signedIn()
        && uid() in getAfter(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }

    function isOwner(tripId) {
      return signedIn() && uid() == tripData(tripId).ownerId;
    }

    // NOTE on the sum(shares) == totalAmount invariant:
    // Rules cannot sum an array of maps, so that check cannot live here. It is
    // enforced in two other places instead — the client blocks the save, and the
    // onExpenseWrite Cloud Function re-checks and flags any document that slips
    // through. What rules CAN enforce is the type: money must be an int (satang),
    // never a float, which is asserted on every expense and settlement write below.

    match /users/{userId} {
      // get only — listing every profile would leak PII (names, promptpay ids).
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && uid() == userId;
      allow delete: if signedIn() && uid() == userId;
    }

    // A single code doc may be fetched by anyone signed in — that is how a
    // non-member joins. Listing the collection would enumerate every trip.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      // Created in the same batch as its trip; only that trip's owner may mint it.
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId == uid()
        && request.resource.data.keys().hasOnly(['tripId', 'tripName', 'active', 'expiresAt']);
      allow update, delete: if signedIn() && isOwner(resource.data.tripId);
    }

    match /trips/{tripId} {
      // List queries can only be proven from resource.data + the query's own
      // constraints — isMember()'s get() of the same doc breaks them with
      // PERMISSION_DENIED. The client query filters memberIds array-contains uid,
      // which satisfies this rule.
      allow read: if signedIn() && uid() in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && uid() in request.resource.data.memberIds;
      // Three distinct update paths:
      //  1. owner — anything except transferring ownership;
      //  2. member — shared fields (note, cover, dates via editor is owner-only in
      //     UI but not security-critical) — never membership, ownership, or the code;
      //  3. join — a signed-in outsider may append exactly themselves, and only
      //     while the trip's invite code doc is still active.
      allow update: if (isOwner(tripId)
            && request.resource.data.ownerId == resource.data.ownerId)
        || (isMember(tripId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['ownerId', 'memberIds', 'inviteCode'].toSet()))
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['memberIds'].toSet())
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.removeAll(resource.data.memberIds) == [uid()]
            && get(/databases/$(database)/documents/inviteCodes/$(resource.data.inviteCode)).data.active == true);
      allow delete: if isOwner(tripId);

      match /members/{memberId} {
        allow read: if isMember(tripId);
        // isMemberAfter covers create-trip and join-by-code batches, where the
        // caller only becomes a member inside this very batch.
        allow create: if isMember(tripId) || isMemberAfter(tripId);
        // Own doc, guest docs (userId == null), or the owner — a member must not
        // rewrite another real member's profile (their promptpayId routes money).
        allow update: if isOwner(tripId)
          || (isMember(tripId) && resource.data.userId == uid())
          || (isMember(tripId) && resource.data.userId == null);
        // The owner, or a member removing themselves (leaving the trip).
        allow delete: if isOwner(tripId)
          || (isMember(tripId) && resource.data.userId == uid());
      }

      match /days/{dayId} {
        allow read: if isMember(tripId);
        // isMemberAfter: day docs are created in the same batch as the trip itself.
        allow write: if isMember(tripId) || isMemberAfter(tripId);

        match /activities/{activityId} {
          allow read, write: if isMember(tripId);
        }
      }

      match /expenses/{expenseId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId)
          && request.resource.data.totalAmount is int
          && request.resource.data.totalAmount >= 0
          && request.resource.data.shares.size() > 0;
        allow update: if isMember(tripId)
          && request.resource.data.totalAmount is int
          && request.resource.data.totalAmount >= 0
          && request.resource.data.shares.size() > 0;
        // Only the person who logged the bill, or the trip owner, may remove it.
        allow delete: if isOwner(tripId)
          || (isMember(tripId) && resource.data.createdBy == uid());
      }

      match /settlements/{settlementId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId)
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.status == 'PENDING';
        // from/to/amount are immutable; flipping status is the RECIPIENT's call
        // only — the sender must not be able to confirm their own transfer.
        allow update: if isMember(tripId)
          && request.resource.data.fromMemberId == resource.data.fromMemberId
          && request.resource.data.toMemberId == resource.data.toMemberId
          && request.resource.data.amount == resource.data.amount
          && (request.resource.data.status == resource.data.status
              || get(/databases/$(database)/documents/trips/$(tripId)/members/$(resource.data.toMemberId)).data.userId == uid());
        allow delete: if isOwner(tripId);
      }

      match /checklist/{itemId} {
        allow read, write: if isMember(tripId);
      }

      match /polls/{pollId} {
        allow read, write: if isMember(tripId);
      }

      match /meetups/{meetupId} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
